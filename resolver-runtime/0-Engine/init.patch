+--##########################################
+-- PASS3 Frame Registrar
+--##########################################
+
+---Create a registerForEvent-compatible registrar for high-frequency frame events.
+---onUpdate is dispatched from 0-Engine's single native onUpdate with the exact CET delta.
+---onDraw is dispatched from 0-Engine's single native onDraw.
+---All other events fall back to the caller's original registerForEvent.
+---@param modName string
+---@param fallbackRegister function|nil
+---@return function
+function Engine.MakeEventRegistrar(modName, fallbackRegister)
+    local source = (type(modName) == "string" and modName ~= "") and modName or "unscoped"
+
+    return function(eventName, callback)
+        if eventName == "onUpdate" and type(callback) == "function" then
+            return adoptedUpdateEmitter:subscribe(callback, source)
+        end
+
+        if eventName == "onDraw" and type(callback) == "function" then
+            return adoptedDrawEmitter:subscribe(callback, source)
+        end
+
+        if type(fallbackRegister) == "function" then
+            return fallbackRegister(eventName, callback)
+        end
+
+        return nil
+    end
 end
 
