 --##########################################
+-- PASS4 Scheduler API
+--##########################################
+
+Engine.Schedule = {}
+
+local function unscopedScheduleArgs(options, fn)
+    if type(options) == "function" then
+        fn = options
+        options = {}
+    end
+
+    local copy = {}
+    for k, v in pairs(options or {}) do copy[k] = v end
+    copy.owner = copy.owner or "unscoped"
+    return copy, fn
+end
+
+function Engine.Schedule.EveryFrame(options, fn)
+    options, fn = unscopedScheduleArgs(options, fn)
+    return Scheduler.EveryFrame(options, fn)
+end
+
+function Engine.Schedule.EveryFrames(interval, options, fn)
+    options, fn = unscopedScheduleArgs(options, fn)
+    return Scheduler.EveryFrames(interval, options, fn)
+end
+
+function Engine.Schedule.Every(seconds, options, fn)
+    options, fn = unscopedScheduleArgs(options, fn)
+    return Scheduler.Every(seconds, options, fn)
+end
+
+function Engine.Schedule.After(seconds, options, fn)
+    options, fn = unscopedScheduleArgs(options, fn)
+    return Scheduler.After(seconds, options, fn)
+end
+
+function Engine.Schedule.NextTick(options, fn)
+    options, fn = unscopedScheduleArgs(options, fn)
+    return Scheduler.NextTick(options, fn)
+end
+
+Engine.Schedule.GetInfo = Scheduler.GetInfo
