{
  "schemaVersion": "0.2",
  "policy": {
    "patchCodeAllowed": false,
    "referenceOverridesShipped": false,
    "identityOnlySelectsCandidate": true,
    "currentSourceProofRequired": true,
    "exactVersionRequired": false,
    "exactShaRequiredForRuleMatch": false,
    "generationStyle": "source-injection",
    "generationDefaultEnabled": false,
    "failClosed": true,
    "runtimeAdmissionThresholdMsPerSecond": 3,
    "runtimeEvidenceRequired": true,
    "referencePatchesShipWithResolver": false,
    "fullPassRule": "A semantic injector can run only when the current capture contains a >=3.0 ms/s measured callback, the library rule matches, and the current live mod source graph proves its anchors.",
    "enabledInjectorCount": 15,
    "profileOnlyRuleCount": 1,
    "note": "The production semantic base is intentionally compact. Runtime cost only earns review; automatic rules require a small, provable state model and must avoid bespoke timing. Rejected hot mods remain evidence only.",
    "admissionPolicy": {
      "runtimeThresholdMsPerSecond": 3,
      "requiresGenericExhausted": true,
      "requiresMeaningfulInactiveState": true,
      "requiresExpensiveWorkUnnecessaryWhileInactive": true,
      "requiresCompleteWakePath": true,
      "preserveRealtimeResponsiveness": true,
      "excludedArchetypes": [
        "REALTIME_CAMERA_SYSTEM",
        "GENERAL_INTERACTION_FRAMEWORK",
        "CONTINUOUS_HUD_PRESENTATION",
        "CONTINUOUS_WORLD_DISCOVERY",
        "UNCERTAIN_WAKE_DISCOVERY",
        "REALTIME_MOVEMENT_INPUT_SYSTEM",
        "CONTROLLER_OUTPUT_WITH_UNPROVEN_DORMANCY"
      ],
      "examplesNotForSemanticBase": [
        "immersive_third_person",
        "ImmersiveFirstPerson",
        "nativeInteractions",
        "Minimap Widgets",
        "sitAnywhere",
        "loot-marker systems",
        "AutoLoot-style world discovery",
        "OverclockedLynxPaws",
        "DualSense Support (until its author handleUpdates lifecycle is fully proven)"
      ],
      "note": "Hot means review-worthy, not semantic-library-worthy. The base catalog is reserved for high-cost features with a provable inactive state and complete safe wake path."
    }
  },
