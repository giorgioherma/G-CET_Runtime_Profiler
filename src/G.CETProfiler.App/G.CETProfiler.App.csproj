<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <PublishTrimmed>false</PublishTrimmed>
    <AssemblyName>G-CET-Runtime-Profiler.App</AssemblyName>
    <RootNamespace>GCETRuntimeProfiler</RootNamespace>
    <ApplicationIcon>..\..\assets\g-cet-app-icon.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\G.CETProfiler.Core\G.CETProfiler.Core.csproj" />
    <EmbeddedResource Include="..\..\assets\g-cet-icon.png">
      <LogicalName>GCETRuntimeProfiler.GCetIcon.png</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\assets\g-cet-app-icon.png">
      <LogicalName>GCETRuntimeProfiler.GCetAppIcon.png</LogicalName>
    </EmbeddedResource>
    <Content Include="..\..\payload\**\*">
      <Link>payload\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </Content>
    <Content Include="..\..\MANIFEST.json">
      <Link>MANIFEST.json</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
</Project>
