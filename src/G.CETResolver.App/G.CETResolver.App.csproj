<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <AssemblyName>G-CET-Resolver</AssemblyName>
    <RootNamespace>GCETRuntimeProfiler.Resolver</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\G.CETProfiler.Core\G.CETProfiler.Core.csproj" />
    <None Include="..\..\resolver-knowledge\high-impact-exceptions.json"
          Link="knowledge\high-impact-exceptions.json"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\resolver-knowledge\semantic-library.json"
          Link="knowledge\semantic-library.json"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\resolver-runtime\0-Engine\**\*"
          Link="runtime\0-Engine\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
